datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SECURITY_OFFICER
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  CLAIM_PENDING
  APPROVED
  RETURNED
  CLOSED
  REJECTED
  EXPIRED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  HANDOVER_SCHEDULED
  RETURNED
  CANCELLED
}

enum StorageArrangement {
  WITH_FINDER
  SECURITY_OFFICE
  STUDENT_SERVICES
}

enum NotificationType {
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  HANDOVER_SCHEDULED
  ITEM_RETURNED
  MATCH_FOUND
  ITEM_MODERATED
  SYSTEM
}

model User {
  id              String         @id @default(uuid())
  fullName        String
  email           String?        @unique
  universityId    String?        @unique
  phone           String
  passwordHash    String
  role            Role           @default(USER)
  department      String?
  avatarUrl       String?
  isActive        Boolean        @default(true)
  pushToken       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           Item[]         @relation("ReportedItems")
  claims          Claim[]        @relation("UserClaims")
  statusHistories StatusHistory[] @relation("UserStatusChanges")
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([isActive])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String   @default("cube-outline")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       Item[]

  @@index([isActive])
}

model Location {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       Item[]

  @@index([isActive])
}

model Item {
  id                String             @id @default(uuid())
  reporterId        String
  type              ItemType
  categoryId        String
  locationId        String
  title             String
  description       String
  color             String?
  brand             String?
  hiddenDetail      String?            // Private ownership verification detail, never sent publicly
  dateEvent         DateTime
  latitude          Float?
  longitude         Float?
  contactPreference String             @default("IN_APP")
  keptAt            StorageArrangement @default(WITH_FINDER)
  status            ItemStatus         @default(OPEN)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  reporter          User               @relation("ReportedItems", fields: [reporterId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  images            ItemImage[]
  claims            Claim[]
  statusHistories   StatusHistory[]

  @@index([status, type, categoryId, createdAt])
  @@index([locationId])
  @@index([reporterId])
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  imageUrl  String
  createdAt DateTime @default(now())

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Claim {
  id                  String          @id @default(uuid())
  itemId              String
  claimantId          String
  proofDescription    String
  verificationAnswers String?         // Serialized answers or explanation
  proofImageUrl       String?
  lostDate            DateTime?
  lostLocation        String?
  status              ClaimStatus     @default(PENDING)
  reviewNote          String?
  reviewedBy          String?
  handoverLocation    String?
  handoverAt          DateTime?
  returnedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  item                Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant            User            @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Restrict)
  statusHistories     StatusHistory[]

  @@index([itemId, status])
  @@index([claimantId])
}

model StatusHistory {
  id        String   @id @default(uuid())
  itemId    String
  claimId   String?
  oldStatus String
  newStatus String
  changedBy String
  reason    String?
  createdAt DateTime @default(now())

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claim     Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  changer   User     @relation("UserStatusChanges", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([claimId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  title         String
  body          String
  type          NotificationType @default(SYSTEM)
  relatedItemId String?
  relatedClaimId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  device    String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  targetType String
  targetId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
