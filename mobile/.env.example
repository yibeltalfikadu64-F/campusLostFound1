# Injibara Campus Lost & Found - Mobile Environment Configuration

# Android Emulator uses 10.0.2.2 to reach host machine localhost
# Physical devices require your computer's local Wi-Fi IP e.g. http://192.168.1.105:5000/api/v1
EXPO_PUBLIC_API_URL="http://10.0.2.2:5000/api/v1"

# App environment
EXPO_PUBLIC_ENV="development"
